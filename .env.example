# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique, utilisée par le dashboard Next.js
SUPABASE_ANON_KEY=eyJ...
# Clé service_role : contourne la RLS. UNIQUEMENT côté service Python,
# jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Ton uuid dans auth.users — le service Python n'a pas de session, il doit
# savoir pour quel compte il travaille.
OWNER_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# France Travail (https://francetravail.io) — compte développeur gratuit
# ---------------------------------------------------------------------------
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# LLM — rédaction des lettres (qualité)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
WRITER_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# LLM — filtrage/matching (low-cost, API compatible OpenAI)
# FILTER_PROVIDER = deepseek | gemini
# ---------------------------------------------------------------------------
FILTER_PROVIDER=deepseek
FILTER_API_KEY=
FILTER_MODEL=deepseek-v4-flash
FILTER_BASE_URL=https://api.deepseek.com/v1
# Pour Gemini :
#   FILTER_PROVIDER=gemini
#   FILTER_MODEL=gemini-2.5-flash-lite
#   FILTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ---------------------------------------------------------------------------
# Cadence
# Doit rester cohérent avec deploy/agents-pipeline.timer : cette valeur
# détermine la fenêtre de recherche demandée aux sources (intervalle + 2 h de
# marge). Mettre 1 ici avec un timer quotidien ferait rater des offres.
# ---------------------------------------------------------------------------
RUN_INTERVAL_HOURS=1

# ---------------------------------------------------------------------------
# Plafonds de dépense
# Le plafond mensuel est volontairement bas : la dépense attendue est d'environ
# 1 €/mois, donc 3 € laisse une marge confortable tout en bornant les dégâts
# si le pipeline part en boucle.
# ---------------------------------------------------------------------------
MONTHLY_BUDGET_EUR=3

# Par exécution : protège une exécution qui dérape.
MAX_LETTERS_PER_RUN=10
# Par jour, toutes exécutions confondues. C'est LE plafond qui compte en
# cadence horaire : sans lui, 24 exécutions produiraient jusqu'à 240 lettres.
MAX_LETTERS_PER_DAY=10
MAX_OFFERS_TO_CLASSIFY_PER_RUN=120

# ---------------------------------------------------------------------------
# Sécurité interne : le dashboard appelle le service agents avec ce jeton.
# Génère-le avec : openssl rand -hex 32
# ---------------------------------------------------------------------------
INTERNAL_TOKEN=

# ---------------------------------------------------------------------------
# Dashboard Next.js
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
AGENTS_BASE_URL=http://agents:8000
